# Default: local SQLite (no external DB). Override for Postgres if you switch drivers later.
DATABASE_URL=sqlite+aiosqlite:///./formbuilder.db

CORS_ORIGINS=["http://localhost:3000"]

# Used to sign JWT access tokens (set a long random value in any shared environment).
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

LOG_LEVEL=INFO
